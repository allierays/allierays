---
interface Props {
  title: string;
  description?: string;
  image?: string;
  fullWidth?: boolean;
  ogType?: string;
  jsonLd?: Record<string, any>;
}

const { title, description = 'Allie Rays — building with AI, writing about what works.', image, fullWidth = false, ogType = 'website', jsonLd } = Astro.props;
const ogImage = image || '/images/allie-headshot-2026.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Allie Rays',
  url: 'https://allierays.com',
  author: {
    '@type': 'Person',
    name: 'Allie Rays',
    url: 'https://allierays.com/about',
    sameAs: [
      'https://linkedin.com/in/allierays',
      'https://x.com/allierays',
      'https://github.com/allierays',
      'https://youtube.com/@allieray',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@allierays" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chiron+Go+Round+TC:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,300;1,8..60,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Allie Rays" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

    <!-- Mermaid (loaded in body below) -->

    <!-- Page view tracking -->
    <script is:inline>
      if (!navigator.userAgent.includes('bot')) {
        navigator.sendBeacon('https://7t1nmysged.execute-api.us-east-1.amazonaws.com/track', JSON.stringify({
          page: location.pathname,
          referrer: document.referrer
        }));
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-left">
        <a href="/" class="header-photo-link">
          <div class="header-photo-wrapper"><img src="/images/allie-headshot-2026.png" alt="Allie Jones" class="header-photo" /></div>
        </a>
        <div class="header-info">
          <a href="/" class="header-name">Allie Jones</a>
          <a href="/" class="header-handle">allierays</a>
          <p class="header-tagline">Head of Applied AI at Go1</p>
          <div class="header-socials">
            <a href="https://www.linkedin.com/in/allierays/" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
            <a href="https://x.com/allierays" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="https://youtube.com/@allieray" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
            <a href="https://github.com/allierays" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
          </div>
        </div>
      </div>
      <nav class="header-nav">
        <a href="/about">About</a>
        <a href="/">Writing</a>
        <a href="/projects">Work</a>
      </nav>
    </header>

    <main class={fullWidth ? 'container-full' : 'container'}>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} Allie Jones <a href="https://allierays.com" style="color: var(--ink-faint); text-decoration: none;">@allierays</a></p>
    </footer>

    <script type="module">
      const pres = document.querySelectorAll('pre[data-language="mermaid"]');
      if (pres.length > 0) {
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
        pres.forEach((pre) => {
          const spans = pre.querySelectorAll('.line');
          const text = Array.from(spans).map(s => s.textContent).join('\n');
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = text;
          pre.replaceWith(div);
        });
        await mermaid.run({ querySelector: '.mermaid' });
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
