---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Allie Rays">
  <div class="not-found">
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="back-link">Back to home</a>
  </div>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 40vh;
    gap: 1rem;
  }

  .not-found h1 {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--ink);
  }

  .not-found p {
    color: var(--ink-muted);
    font-size: 1.125rem;
  }

  .back-link {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--navy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .back-link:hover {
    color: var(--gold);
  }
</style>
