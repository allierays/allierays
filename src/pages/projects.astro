---
import Base from '../layouts/Base.astro';
import { projects, projectUrl } from '../data/projects';
---

<Base title="Projects — Allie Rays" description="Projects built by Allie Rays." fullWidth>
  <section class="projects">
    <h1>Projects</h1>
    <p class="projects-intro">
      Things I've built to explore how agents reason, remember, evaluate, and get useful work done.
    </p>

    <div class="project-list">
      {projects.map((project) => (
        <div class="project">
          <p class="project-date">{project.date}</p>
          <h2>{project.title}</h2>
          <p class="project-meta">{project.stack}</p>
          <p>{project.body}</p>
          {projectUrl(project) && (
            <a class="action-btn" href={projectUrl(project)} target="_blank" rel="noopener">
              View on GitHub
            </a>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .projects { max-width: 1200px; margin: 2rem auto 0; }
  .projects > h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #1e3a5f 0%, #0891b2 50%, #14b8a6 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .projects-intro {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-light);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--marble);
  }
  .project { padding-bottom: 2.5rem; border-bottom: 1px solid var(--marble); }
  .project:last-child { border-bottom: none; }
  .project-date {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    margin: 0 0 0.35rem;
  }
  .project h2 {
    font-size: 1.25rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0.01em;
    margin: 0 0 0.25rem;
  }
  .project-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }
  .project p:last-of-type { margin-bottom: 1rem; font-size: 0.9375rem; }
</style>
